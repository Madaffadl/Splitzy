generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  avatarUrl     String?   @map("avatar_url")
  googleId      String?   @unique @map("google_id")
  // Freemium hook: everything is free today, but the plan + AI-scan usage
  // counter let us gate/upsell the variable-cost AI scan later without a
  // schema migration. aiScanResetAt marks the start of the current monthly
  // window; the counter resets when now() passes it + 1 month.
  plan          String    @default("free")
  aiScanCount   Int       @default(0) @map("ai_scan_count")
  aiScanResetAt DateTime? @map("ai_scan_reset_at")
  // Per-user override; null = use plan default (15 for free, ∞ for pro).
  aiScanLimit   Int?      @map("ai_scan_limit")
  // Set by admin to suspend access; null = active account.
  bannedAt      DateTime? @map("banned_at")
  // Access role: "user" (default) or "admin". Admins reach /admin + /api/admin/*.
  // A bootstrap email (see lib/admin-auth) is always treated as admin regardless
  // of this column, so the first admin can never lock themselves out.
  role          String    @default("user")
  // Last successful sign-in (set by the auth callback). Powers the admin
  // "active today" view without scanning the activity log.
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ownedTrips      Trip[]           @relation("TripOwner")
  tripMemberships TripMember[]
  createdReceipts Receipt[]        @relation("ReceiptCreator")
  paidReceipts    Receipt[]        @relation("ReceiptPayer")
  itemAssignments ItemAssignment[]
  sharedSummaries SharedSummary[]  @relation("SharedSummaryCreator")
  activityEvents  ActivityEvent[]  @relation("UserActivity")

  @@map("users")
}

model Trip {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String    @map("owner_id") @db.Uuid
  // Optimistic concurrency: bump on every update; clients send the version they
  // observed and the WHERE clause filters by it. Mismatch → 409 Conflict.
  version   Int       @default(1)
  // Soft delete. Active rows have deletedAt = NULL; deleted rows are kept for
  // audit + accidental-delete recovery. List queries must filter `deletedAt: null`.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Travel Spend fields. Participants are name-based (not User accounts), stored
  // as a JSON snapshot; the split targets differ from `members` (the accounts
  // that can edit the trip). Budget is an optional spend target.
  budget           Float?
  participantsJson Json?  @map("participants_json")

  owner          User                @relation("TripOwner", fields: [ownerId], references: [id])
  members        TripMember[]
  receipts       Receipt[]
  tripReceipts   TripReceipt[]
  tripPayments   TripPayment[]
  invites        TripInvite[]
  changeRequests TripChangeRequest[]

  // Pagination + ownership filtering (most common query pattern).
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("trips")
}

// A single Travel Spend receipt, stored as a JSON payload (the client's
// name-based Receipt shape) so the split model doesn't fight the User-FK
// assumptions of the legacy normalized Receipt table. One row per receipt keeps
// concurrent adds independent and makes realtime granular later.
model TripReceipt {
  id          String   @id
  tripId      String   @map("trip_id") @db.Uuid
  payload     Json
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_receipts")
}

// A recorded settle-up payment between two participants (by name-id). Append
// only; adjusts net balances so "mark paid" is real and synced, not cosmetic.
model TripPayment {
  id                String   @id @default(uuid()) @db.Uuid
  tripId            String   @map("trip_id") @db.Uuid
  fromParticipantId String   @map("from_participant_id")
  toParticipantId   String   @map("to_participant_id")
  amount            Float
  // Optional foreign-currency fields. When set, `amount` is the native
  // foreign amount (e.g. 100 for 100 USD) and fxRate converts it to IDR
  // for settlement math. null/null = IDR payment (no conversion needed).
  currency          String?
  fxRate            Float?   @map("fx_rate")
  note              String?
  // Origin of the payment. null = a manual settle-up; "share:<receiptId>:<pid>"
  // = generated by a per-receipt "mark my share paid" checkbox (lets the client
  // toggle it and render the checkbox state). The ledger is the single source of
  // truth for what has been settled.
  source            String?
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_payments")
}

// Invite link token → join a trip as a member (collaboration).
model TripInvite {
  token       String   @id
  tripId      String   @map("trip_id") @db.Uuid
  role        String   @default("member")
  createdById String?  @map("created_by") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_invites")
}

model TripMember {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
  // Filter pattern: "all members of trip X" and "all trips user Y is in".
  @@index([tripId])
  @@index([userId])
  @@map("trip_members")
}

// A member's proposed batch of edits awaiting owner review (PR-style workflow).
// Members cannot write the trip directly; their changes are captured here as a
// batch of ops and only applied to the canonical trip when the owner approves.
model TripChangeRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tripId       String    @map("trip_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  // pending → approved | declined. `superseded` reserved for future auto-close.
  status       String    @default("pending")
  // Trip version the proposal was built against. Approval is last-write-wins;
  // a mismatch (owner edited meanwhile) is surfaced to the reviewer as a warning.
  baseVersion  Int       @map("base_version")
  // Serialized ChangeOp[] (see src/lib/change-ops.ts): the ordered edits to replay.
  ops          Json
  note         String?
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Owner inbox query: pending requests for a trip, newest first.
  @@index([tripId, status])
  @@map("trip_change_requests")
}

model Receipt {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String?   @map("trip_id") @db.Uuid
  title            String
  payerId          String    @map("payer_id") @db.Uuid
  tax              Float     @default(0)
  service          Float     @default(0)
  date             DateTime?
  participantsJson Json?     @map("participants_json")
  createdById      String    @map("created_by") @db.Uuid
  // Optimistic concurrency — see Trip.version.
  version          Int       @default(1)
  // Soft delete — active rows have deletedAt = NULL.
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer     User          @relation("ReceiptPayer", fields: [payerId], references: [id])
  createdBy User          @relation("ReceiptCreator", fields: [createdById], references: [id])
  items     ReceiptItem[]

  // Common queries:
  //   * "receipts I created, newest first" — list/history endpoint.
  //   * "receipts in this trip" — trip detail endpoint.
  //   * Soft-delete filter is added to every list query.
  @@index([createdById, createdAt(sort: Desc)])
  @@index([tripId])
  @@index([payerId])
  @@index([deletedAt])
  @@map("receipts")
}

model ReceiptItem {
  id        String @id @default(uuid()) @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid
  name      String
  qty       Int    @default(1)
  unitPrice Float  @map("unit_price")
  total     Float
  sortOrder Int    @default(0) @map("sort_order")

  receipt     Receipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  assignments ItemAssignment[]

  // Items are always loaded by receiptId.
  @@index([receiptId])
  @@map("receipt_items")
}

model SharedSummary {
  id   String @id @default(uuid()) @db.Uuid
  // Public short code that appears in the link (/s/<code>). Random, unguessable,
  // unique. Indexed implicitly via @unique — the read path looks up by it.
  code String @unique

  // Immutable point-in-time snapshot of the split (trip or single receipt):
  // { v, type, title, participants, receipts }. Trip data otherwise lives only
  // in the creator's browser — this is the one place a copy is persisted so a
  // link can render server-side for anyone, read-only. Validated before write.
  payload Json

  // Creator, when authenticated. Null for guest-created links (trip mode works
  // without an account). No cascade: deleting a user shouldn't break live links.
  createdById String? @map("created_by") @db.Uuid

  // Links are short-lived; the admin cleanup job hard-deletes expired rows.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  createdBy User? @relation("SharedSummaryCreator", fields: [createdById], references: [id])

  // Cleanup job sweeps by expiry.
  @@index([expiresAt])
  @@map("shared_summaries")
}

model ItemAssignment {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  item ReceiptItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
  // "all assignments for an item" + "what items did user X consume".
  @@index([itemId])
  @@index([userId])
  @@map("item_assignments")
}

// Append-only trail of privileged admin mutations (plan/quota/ban changes).
// No FK to users on purpose: the trail must survive account deletion, so the
// actor + target emails are denormalized snapshots taken at write time. App
// code only ever inserts and reads — it never updates or deletes rows here.
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  // Who performed the action (the admin). Email is a durable snapshot.
  actorId      String   @map("actor_id") @db.Uuid
  actorEmail   String   @map("actor_email")
  // What happened, e.g. "plan.change", "quota.reset", "quota.limit",
  // "user.ban", "user.unban". Stable machine-readable slug.
  action       String
  // Whom it affected + a before/after snapshot in `metadata`.
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetEmail  String?  @map("target_email")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  // The activity feed reads newest-first; target lookups group per user.
  @@index([createdAt(sort: Desc)])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}

// Append-only user activity log: one row per meaningful completed action, so the
// admin can see who was active on a given day and which feature they used.
// Single/Multiple are otherwise local-only (no server trace), so those events
// arrive via a client beacon (POST /api/activity); login + travel are logged
// server-side. Swept by the cleanup job after a short retention window.
model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Durable email snapshot so the feed reads without a join and survives edits.
  userEmail String   @map("user_email")
  // Product area: "single" | "multiple" | "travel" | "account".
  feature   String
  // Machine-readable slug, e.g. "login" | "split.created" | "share.created".
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserActivity", fields: [userId], references: [id], onDelete: Cascade)

  // Feed reads newest-first for a date range; per-user grouping for drill-downs.
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_events")
}
