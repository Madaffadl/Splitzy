generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  avatarUrl     String?   @map("avatar_url")
  googleId      String?   @unique @map("google_id")
  // Freemium hook: everything is free today, but the plan + AI-scan usage
  // counter let us gate/upsell the variable-cost AI scan later without a
  // schema migration. aiScanResetAt marks the start of the current monthly
  // window; the counter resets when now() passes it + 1 month.
  plan          String    @default("free")
  aiScanCount   Int       @default(0) @map("ai_scan_count")
  aiScanResetAt DateTime? @map("ai_scan_reset_at")
  // Per-user override; null = use plan default (15 for free, ∞ for pro).
  aiScanLimit   Int?      @map("ai_scan_limit")
  // When the current paid Pro period lapses. null = not on a timed plan
  // (either free, or admin-comped Pro that never expires). Set by the Xendit
  // webhook on a successful one-time monthly payment; entitlement checks treat
  // plan="pro" with a past proExpiresAt as expired (back to free). See
  // lib/billing/entitlements.
  proExpiresAt  DateTime? @map("pro_expires_at")
  // Unique short code for referral links (?ref=CODE). Generated lazily on
  // first request to GET /api/me/referral — null until the user visits dashboard.
  referralCode  String?   @unique @map("referral_code")
  // Set by admin to suspend access; null = active account.
  bannedAt      DateTime? @map("banned_at")
  // Access role: "user" (default) or "admin". Admins reach /admin + /api/admin/*.
  // A bootstrap email (see lib/admin-auth) is always treated as admin regardless
  // of this column, so the first admin can never lock themselves out.
  role          String    @default("user")
  // Last successful sign-in (set by the auth callback). Powers the admin
  // "active today" view without scanning the activity log.
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  referrals       Referral[]       @relation("ReferralReferrer")
  referredBy      Referral?        @relation("ReferralReferee")
  ownedTrips      Trip[]           @relation("TripOwner")
  tripMemberships TripMember[]
  createdReceipts Receipt[]        @relation("ReceiptCreator")
  paidReceipts    Receipt[]        @relation("ReceiptPayer")
  itemAssignments ItemAssignment[]
  sharedSummaries SharedSummary[]  @relation("SharedSummaryCreator")
  activityEvents  ActivityEvent[]  @relation("UserActivity")
  payments        Payment[]        @relation("UserPayments")
  reviews         Review[]         @relation("UserReviews")

  @@map("users")
}

// One-time monthly Pro payments via Xendit (audit EPIC 1 / Sprint 2). Each row
// is one invoice: created "pending", flipped to "paid" by the Xendit webhook,
// which then extends the buyer's User.proExpiresAt by periodDays. externalId is
// our idempotency key (sent to Xendit as external_id); xenditId is theirs.
model Payment {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  externalId String    @unique @map("external_id")
  xenditId   String?   @unique @map("xendit_id")
  // Whole-rupiah amount (IDR has no minor units), e.g. 29000.
  amount     Int
  currency   String    @default("IDR")
  // pending | paid | expired | failed
  status     String    @default("pending")
  plan       String    @default("pro")
  periodDays Int       @default(30) @map("period_days")
  invoiceUrl String?   @map("invoice_url")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("payments")
}

// One row per successful referral. referee_id is unique — a new user can only
// be referred once. referrer earns REFERRAL_REWARD_DAYS of Pro per referral.
model Referral {
  id         String    @id @default(uuid()) @db.Uuid
  referrerId String    @map("referrer_id") @db.Uuid
  refereeId  String    @unique @map("referee_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  rewardedAt DateTime? @map("rewarded_at")
  rewardDays Int       @default(14) @map("reward_days")

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

model Trip {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String    @map("owner_id") @db.Uuid
  // Optimistic concurrency: bump on every update; clients send the version they
  // observed and the WHERE clause filters by it. Mismatch → 409 Conflict.
  version   Int       @default(1)
  // Soft delete. Active rows have deletedAt = NULL; deleted rows are kept for
  // audit + accidental-delete recovery. List queries must filter `deletedAt: null`.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Travel Spend fields. Participants are name-based (not User accounts), stored
  // as a JSON snapshot; the split targets differ from `members` (the accounts
  // that can edit the trip). Budget is an optional spend target.
  budget           Float?
  participantsJson Json?  @map("participants_json")

  owner          User                @relation("TripOwner", fields: [ownerId], references: [id])
  members        TripMember[]
  receipts       Receipt[]
  tripReceipts   TripReceipt[]
  tripPayments   TripPayment[]
  invites        TripInvite[]
  changeRequests TripChangeRequest[]

  // Pagination + ownership filtering (most common query pattern).
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("trips")
}

// A single Travel Spend receipt, stored as a JSON payload (the client's
// name-based Receipt shape) so the split model doesn't fight the User-FK
// assumptions of the legacy normalized Receipt table. One row per receipt keeps
// concurrent adds independent and makes realtime granular later.
model TripReceipt {
  id          String   @id
  tripId      String   @map("trip_id") @db.Uuid
  payload     Json
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_receipts")
}

// A recorded settle-up payment between two participants (by name-id). Append
// only; adjusts net balances so "mark paid" is real and synced, not cosmetic.
model TripPayment {
  id                String   @id @default(uuid()) @db.Uuid
  tripId            String   @map("trip_id") @db.Uuid
  fromParticipantId String   @map("from_participant_id")
  toParticipantId   String   @map("to_participant_id")
  amount            Float
  // Optional foreign-currency fields. When set, `amount` is the native
  // foreign amount (e.g. 100 for 100 USD) and fxRate converts it to IDR
  // for settlement math. null/null = IDR payment (no conversion needed).
  currency          String?
  fxRate            Float?   @map("fx_rate")
  note              String?
  // Origin of the payment. null = a manual settle-up; "share:<receiptId>:<pid>"
  // = generated by a per-receipt "mark my share paid" checkbox (lets the client
  // toggle it and render the checkbox state). The ledger is the single source of
  // truth for what has been settled.
  source            String?
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_payments")
}

// Invite link token → join a trip as a member (collaboration).
model TripInvite {
  token       String   @id
  tripId      String   @map("trip_id") @db.Uuid
  role        String   @default("member")
  createdById String?  @map("created_by") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_invites")
}

model TripMember {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
  // Filter pattern: "all members of trip X" and "all trips user Y is in".
  @@index([tripId])
  @@index([userId])
  @@map("trip_members")
}

// A member's proposed batch of edits awaiting owner review (PR-style workflow).
// Members cannot write the trip directly; their changes are captured here as a
// batch of ops and only applied to the canonical trip when the owner approves.
model TripChangeRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tripId       String    @map("trip_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  // pending → approved | declined. `superseded` reserved for future auto-close.
  status       String    @default("pending")
  // Trip version the proposal was built against. Approval is last-write-wins;
  // a mismatch (owner edited meanwhile) is surfaced to the reviewer as a warning.
  baseVersion  Int       @map("base_version")
  // Serialized ChangeOp[] (see src/lib/change-ops.ts): the ordered edits to replay.
  ops          Json
  note         String?
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Owner inbox query: pending requests for a trip, newest first.
  @@index([tripId, status])
  @@map("trip_change_requests")
}

// A user's rating + written testimonial, awaiting moderation before it can be
// shown publicly. Mirrors the TripChangeRequest review workflow above: a
// user-authored body that an approver promotes, never published on submit.
//
// The landing page still renders hardcoded placeholder testimonials; this table
// is the collection side only. Nothing here reaches a public surface until the
// landing page is deliberately rewired to read from it.
model Review {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  rating Int
  body   String?

  // Name snapshot taken at submit time. A review is approved as a specific
  // (name, rating, body) tuple; attribution must not silently rewrite itself
  // when the author renames their account afterwards. Nullable because
  // User.name is.
  displayName String? @map("display_name")

  // Which entry point collected it: "dashboard" | "summary". Analytics only —
  // never 400 on this, an unrecognised value just falls back to "dashboard".
  source String @default("dashboard")

  // UI language at submit time ("id" | "en"), so a future public surface can
  // show testimonials in the reader's language instead of mixing them.
  locale String?

  // pending → approved | rejected. Editing an approved review returns it to
  // pending, so an innocuous quote cannot be swapped for spam after the fact.
  status       String    @default("pending")
  // Internal moderator note on a rejection. Never shown publicly.
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Cascade is load-bearing, not a style choice: five existing FKs to User use
  // the default RESTRICT and together make account deletion impossible
  // (PBI-023). A sixth would deepen that hole. Cascading is also the right
  // privacy answer — deleting the account withdraws the testimonial with it.
  user User @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  // One review per account; re-submitting edits the existing row.
  @@unique([userId])
  // Moderation queue: pending first, newest first.
  @@index([status, createdAt(sort: Desc)])
  @@map("reviews")
}

model Receipt {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String?   @map("trip_id") @db.Uuid
  title            String
  payerId          String    @map("payer_id") @db.Uuid
  tax              Float     @default(0)
  service          Float     @default(0)
  date             DateTime?
  participantsJson Json?     @map("participants_json")
  // The complete client-side Receipt (items with their per-person assignments,
  // fees, discounts, currency + locked fxRate) as one JSON document.
  //
  // The relational columns above cannot represent a real split: ItemAssignment
  // has a foreign key to User, so it can only say "an account holder consumed
  // this", while a split is between arbitrary named people who mostly have no
  // account. Importing a guest split therefore dropped every assignment, fee
  // and discount on the floor. This mirrors TripReceipt.payload, which is how
  // the Travel path has always stored receipts losslessly.
  //
  // Null on legacy rows — readers fall back to the relational columns.
  payloadJson      Json?     @map("payload_json")
  // Saved single/multiple splits are short-lived working copies, not an
  // archive: they expire SAVED_SPLIT_TTL_DAYS after the LAST save, and the
  // cleanup job hard-deletes them. Null = no expiry (Travel receipts, which
  // live until the user deletes the trip).
  //
  // The durable record of a finished split is the exported text the user
  // copies into WhatsApp — that carries every amount plus the payment details,
  // so letting the working copy lapse loses nothing they relied on.
  expiresAt        DateTime? @map("expires_at")
  // Short code of the shared read-only link created for this split, if any.
  // Held here so re-saving updates THAT link instead of minting a second one
  // (the client used to keep the code in component state, so a remount silently
  // created a rival link showing different numbers).
  shareCode        String?   @map("share_code")
  createdById      String    @map("created_by") @db.Uuid
  // Optimistic concurrency — see Trip.version.
  version          Int       @default(1)
  // Soft delete — active rows have deletedAt = NULL.
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer     User          @relation("ReceiptPayer", fields: [payerId], references: [id])
  createdBy User          @relation("ReceiptCreator", fields: [createdById], references: [id])
  items     ReceiptItem[]

  // Common queries:
  //   * "receipts I created, newest first" — list/history endpoint.
  //   * "receipts in this trip" — trip detail endpoint.
  //   * Soft-delete filter is added to every list query.
  @@index([createdById, createdAt(sort: Desc)])
  @@index([tripId])
  @@index([payerId])
  @@index([deletedAt])
  // Cleanup job sweeps lapsed saved splits by expiry.
  @@index([expiresAt])
  @@map("receipts")
}

model ReceiptItem {
  id        String @id @default(uuid()) @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid
  name      String
  qty       Int    @default(1)
  unitPrice Float  @map("unit_price")
  total     Float
  sortOrder Int    @default(0) @map("sort_order")

  receipt     Receipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  assignments ItemAssignment[]

  // Items are always loaded by receiptId.
  @@index([receiptId])
  @@map("receipt_items")
}

model SharedSummary {
  id   String @id @default(uuid()) @db.Uuid
  // Public short code that appears in the link (/s/<code>). Random, unguessable,
  // unique. Indexed implicitly via @unique — the read path looks up by it.
  code String @unique

  // Immutable point-in-time snapshot of the split (trip or single receipt):
  // { v, type, title, participants, receipts }. Trip data otherwise lives only
  // in the creator's browser — this is the one place a copy is persisted so a
  // link can render server-side for anyone, read-only. Validated before write.
  payload Json

  // Creator, when authenticated. Null for guest-created links (trip mode works
  // without an account). No cascade: deleting a user shouldn't break live links.
  createdById String? @map("created_by") @db.Uuid

  // Links are short-lived; the admin cleanup job hard-deletes expired rows.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  // Snapshots used to be immutable. They are now refreshed when the split they
  // came from is re-saved, so a link shared in a group chat stops showing stale
  // numbers. That makes "when was this last changed" something the viewer needs
  // to see — an amount that can move silently after everyone agreed on it is
  // worse than a stale one.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  createdBy User? @relation("SharedSummaryCreator", fields: [createdById], references: [id])

  // Cleanup job sweeps by expiry.
  @@index([expiresAt])
  @@map("shared_summaries")
}

model ItemAssignment {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  item ReceiptItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
  // "all assignments for an item" + "what items did user X consume".
  @@index([itemId])
  @@index([userId])
  @@map("item_assignments")
}

// Append-only trail of privileged admin mutations (plan/quota/ban changes).
// No FK to users on purpose: the trail must survive account deletion, so the
// actor + target emails are denormalized snapshots taken at write time. App
// code only ever inserts and reads — it never updates or deletes rows here.
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  // Who performed the action (the admin). Email is a durable snapshot.
  actorId      String   @map("actor_id") @db.Uuid
  actorEmail   String   @map("actor_email")
  // What happened, e.g. "plan.change", "quota.reset", "quota.limit",
  // "user.ban", "user.unban". Stable machine-readable slug.
  action       String
  // Whom it affected + a before/after snapshot in `metadata`.
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetEmail  String?  @map("target_email")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  // The activity feed reads newest-first; target lookups group per user.
  @@index([createdAt(sort: Desc)])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}

// Append-only user activity log: one row per meaningful completed action, so the
// admin can see who was active on a given day and which feature they used.
// Single/Multiple are otherwise local-only (no server trace), so those events
// arrive via a client beacon (POST /api/activity); login + travel are logged
// server-side. Swept by the cleanup job after a short retention window.
model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Durable email snapshot so the feed reads without a join and survives edits.
  userEmail String   @map("user_email")
  // Product area: "single" | "multiple" | "travel" | "account".
  feature   String
  // Machine-readable slug, e.g. "login" | "split.created" | "share.created".
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserActivity", fields: [userId], references: [id], onDelete: Cascade)

  // Feed reads newest-first for a date range; per-user grouping for drill-downs.
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_events")
}
