# Google Gemini AI (receipt scanning)
GEMINI_API_KEY=your_gemini_api_key

# Maintenance mode
MAINTENANCE_MODE=false

# Admin bootstrap allowlist (comma-separated emails). ALWAYS treated as admin
# regardless of the DB `role` column — a lockout-recovery guard. No email is
# hardcoded in source; set this in each environment. Leave empty to rely only
# on the DB role. Example: ADMIN_BOOTSTRAP_EMAILS=owner@example.com
ADMIN_BOOTSTRAP_EMAILS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (Supabase PostgreSQL)
# PRODUCTION uses the production Supabase project. PREVIEW/STAGING deployments
# must point these at a SEPARATE staging Supabase project so transformation
# work never touches real user data. See docs/ENVIRONMENT_ISOLATION.md.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Feature Flags (product transformation) ───────────────────────────────
# Every flag defaults to OFF. Set to 1/true/on to enable. Flip in Vercel env
# (scope: Preview to test; Production to release). See src/lib/flags.ts.
# UI flags (exposed to browser):
NEXT_PUBLIC_FLAG_NEW_LANDING=0
NEXT_PUBLIC_FLAG_DASHBOARD=0
NEXT_PUBLIC_FLAG_ONBOARDING=0
NEXT_PUBLIC_FLAG_PRICING_PAGE=0
NEXT_PUBLIC_FLAG_DESIGN_SYSTEM_V2=0
# Server-only flags:
FLAG_XENDIT_CHECKOUT=0
FLAG_DISTRIBUTED_RATE_LIMIT=0
