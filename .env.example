# Google Gemini AI (receipt scanning)
GEMINI_API_KEY=your_gemini_api_key

# Maintenance mode
MAINTENANCE_MODE=false

# Public support/contact email shown in the footer and legal pages.
# Point this at a real mailbox per environment. Defaults to support@splitzy.my.id.
NEXT_PUBLIC_SUPPORT_EMAIL=support@splitzy.my.id

# Admin bootstrap allowlist (comma-separated emails). ALWAYS treated as admin
# regardless of the DB `role` column — a lockout-recovery guard. No email is
# hardcoded in source; set this in each environment. Leave empty to rely only
# on the DB role. Example: ADMIN_BOOTSTRAP_EMAILS=owner@example.com
ADMIN_BOOTSTRAP_EMAILS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (Supabase PostgreSQL)
# PRODUCTION uses the production Supabase project. PREVIEW/STAGING deployments
# must point these at a SEPARATE staging Supabase project so transformation
# work never touches real user data. See docs/ENVIRONMENT_ISOLATION.md.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Feature Flags (product transformation) ───────────────────────────────
# Every flag defaults to OFF. Set to 1/true/on to enable. Flip in Vercel env
# (scope: Preview to test; Production to release). See src/lib/flags.ts.
# UI flags (exposed to browser). Note: new-landing, dashboard, and onboarding
# were contracted in Sprint 6 (now permanent features, no longer flagged).
NEXT_PUBLIC_FLAG_PRICING_PAGE=0
# Live trip collaboration (Sprint 6). When ON, the server sends a signal (no
# data) to a per-trip Supabase Broadcast channel after each trip write, and
# clients refetch. Needs SUPABASE_SERVICE_ROLE_KEY set (server) to send. Inert
# when OFF — trips still update on focus/reconnect. See docs discussion.
NEXT_PUBLIC_FLAG_REALTIME=0
# Server-only flags:
FLAG_XENDIT_CHECKOUT=0
FLAG_DISTRIBUTED_RATE_LIMIT=0

# ── Xendit payments (Sprint 2 — Pro checkout) ────────────────────────────
# Only used when FLAG_XENDIT_CHECKOUT=1. Checkout stays inert until the secret
# key is set. Get keys from the Xendit dashboard (https://dashboard.xendit.co).
# XENDIT_WEBHOOK_TOKEN is the "Verification token" from Settings -> Webhooks; it
# must match the x-callback-token Xendit sends to /api/webhooks/xendit.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Upstash Redis (distributed rate limiting, T-01) ──────────────────────
# Only used when FLAG_DISTRIBUTED_RATE_LIMIT=1. When unset, rate limiting
# falls back to the per-instance in-memory limiter. Create a database at
# https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry error monitoring (T-19) ───────────────────────────────────────
# Sentry stays completely inert until a DSN is set — safe to leave blank.
# SENTRY_DSN is server-side; NEXT_PUBLIC_SENTRY_DSN is exposed to the browser.
# Usually the same project DSN. Get it from your Sentry project settings.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── PostHog product analytics (Sprint 3 — conversion funnel) ─────────────
# Distinct from the admin ActivityEvent monitoring: this powers the product
# funnel (landing → scan → split → upgrade). posthog-js is only loaded when a
# key is set, so analytics is completely inert (and not shipped) when blank.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Cron (Sprint 3 — Pro-expiry housekeeping) ────────────────────────────
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/*. The
# job refuses to run unless this is set. Use a long random string.
CRON_SECRET=

# ── Email (Sprint 5 — transactional / welcome) ───────────────────────────
# Backed by Resend (https://resend.com). Email is inert until the key is set:
# no welcome emails are sent. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=Splitzy <onboarding@splitzy.my.id>

# ── SEO / Search Console (Sprint 7) ──────────────────────────────────────
# Ownership-verification token for Google Search Console. In Search Console
# choose "URL prefix" → https://www.splitzy.my.id → "HTML tag", and copy ONLY
# the content value of the meta tag (not the whole tag) here. The root layout
# renders the tag when this is set and omits it when blank.
#
# Verifying is the prerequisite for everything else in SEO: without it there is
# no index-coverage report, no query data, and no way to submit the sitemap or
# request re-indexing.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
